
#
# Preferences
#
preferences set plugin-enable-svdatabrowser-new 1
preferences set plugin-enable-groupscope 0
preferences set plugin-enable-interleaveandcompare 0
preferences set plugin-enable-waveformfrequencyplot 0

#
# Mnemonic Maps
#
mmap new  -reuse -name {Boolean as Logic} -radix %b -contents {{%c=FALSE -edgepriority 1 -shape low}
{%c=TRUE -edgepriority 1 -shape high}}
mmap new  -reuse -name {Example Map} -radix %x -contents {{%b=11???? -bgcolor orange -label REG:%x -linecolor yellow -shape bus}
{%x=1F -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=2C -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=* -label %x -linecolor gray -shape bus}}

#
# Waveform windows
#
if {[catch {window new WaveWindow -name "Waveform 1" -geometry 1536x793+0+23}] != ""} {
    window geometry "Waveform 1" 1536x793+0+23
}
window target "Waveform 1" on
waveform using {Waveform 1}
waveform sidebar select designbrowser
waveform set \
    -primarycursor TimeA \
    -signalnames name \
    -signalwidth 175 \
    -units ps \
    -valuewidth 75
waveform baseline set -time 0

set id [waveform add -signals  {
	{simulator::ifx_dig_top.DUT.data_in[15:0]}
	} ]
waveform hierarchy collapse $id
set id [waveform add -signals  {
	{simulator::ifx_dig_top.DUT.data_out[15:0]}
	} ]
waveform hierarchy collapse $id
set id [waveform add -signals  {
	{simulator::ifx_dig_top.DUT.regs.FILTER_CTRL[0:15]}
	} ]
waveform hierarchy expand $id
set id [waveform add -signals  {
	{simulator::ifx_dig_top.DUT.regs.INT_STATUS[0:1]}
	} ]
set id [waveform add -signals  {
	simulator::ifx_dig_top.DUT.regs.N
	} ]
set id [waveform add -signals  {
	simulator::ifx_dig_top.DUT.regs.NUM_STATUS_REGS
	} ]
set id [waveform add -signals  {
	simulator::ifx_dig_top.DUT.regs.acc_en_i
	} ]
set id [waveform add -signals  {
	{simulator::ifx_dig_top.DUT.regs.addr_i[4:0]}
	} ]
set id [waveform add -signals  {
	simulator::ifx_dig_top.DUT.regs.addr_size
	} ]
set id [waveform add -signals  {
	simulator::ifx_dig_top.DUT.regs.clk_i
	} ]
set id [waveform add -signals  {
	{simulator::ifx_dig_top.DUT.regs.filter_type_o[31:0]}
	} ]
set id [waveform add -signals  {
	{simulator::ifx_dig_top.DUT.regs.in_int_i[15:0]}
	} ]
set id [waveform add -signals  {
	{simulator::ifx_dig_top.DUT.regs.int_en_o[15:0]}
	} ]
set id [waveform add -signals  {
	{simulator::ifx_dig_top.DUT.regs.rdata_o[7:0]}
	} ]
set id [waveform add -signals  {
	simulator::ifx_dig_top.DUT.regs.rstn_i
	} ]
set id [waveform add -signals  {
	{simulator::ifx_dig_top.DUT.regs.wd_rst_o[15:0]}
	} ]
set id [waveform add -signals  {
	{simulator::ifx_dig_top.DUT.regs.wdata_i[7:0]}
	} ]
set id [waveform add -signals  {
	{simulator::ifx_dig_top.DUT.regs.window_size_o[63:0]}
	} ]
set id [waveform add -signals  {
	simulator::ifx_dig_top.DUT.regs.wr_en_i
	} ]

waveform xview limits 10000ps 3465000ps

#
# Waveform Window Links
#

#
# Console windows
#
console set -windowname Console
window geometry Console 1536x793+0+23

#
# Layout selection
#
